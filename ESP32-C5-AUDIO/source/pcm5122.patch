+// SPDX-License-Identifier: BUSL-1.1
+
+//! PCM5122 control for the Raspberry Pi DAC+ (formerly IQaudio DAC+).
+//!
+//! ESP32 supplies Philips I2S, two 16-bit slots (BCK = 32 * LRCK).
+//! The PCM5122 is an I2S slave, with its PLL referenced to BCK, no MCLK.
+//! Explicit VREF-mode clock settings follow TI SLAS763C, Table 131.
+//! Only 32, 44.1, 48, 88.2 and 96 kHz are supported by this driver.
+//! Lower rates need wider slots, a separate MCLK, or resampling; the
+//! current 32-fs BCK would be below the PLL's 1 MHz input minimum.
+#![no_std]
+#![forbid(unsafe_code)]
+#![warn(missing_docs)]
+
+use embedded_hal::{delay::DelayNs, i2c::I2c};
+
+/// The DAC+'s 7-bit I2C address (not the 8-bit bus address 0x98).
+pub const ADDRESS: u8 = 0x4c;
+
+const PAGE: u8 = 0;
+const RESET: u8 = 1;
+const POWER: u8 = 2;
+const MUTE: u8 = 3;
+const PLL: u8 = 4;
+const SYNC: u8 = 19;
+const ERROR_DETECT: u8 = 37;
+const BOTH_MUTED: u8 = 0x11;
+const STANDBY: u8 = 0x10;
+const LOCK_POLLS: usize = 100;
+
+/// A control-bus failure, unsupported wire format, or missing clock.
+#[derive(Debug, PartialEq, Eq)]
+pub enum Error<E> {
+    /// The underlying bus error.
+    Bus(E),
+    /// This driver requires 16-bit samples and one of its documented rates.
+    UnsupportedFormat {
+        /// Requested LRCK sample rate, in Hz.
+        rate: u32,
+        /// Requested sample width, in bits.
+        bits: u8,
+    },
+    /// The PLL did not lock within 100 ms; the output remains muted.
+    PllUnlocked,
+}
+
+/// Actual divider values; registers encode dividers as value minus one.
+#[derive(Clone, Copy, Debug)]
+struct Clock {
+    j: u8,
+    dsp_div: u8,
+    osr_div: u8,
+    fs_speed: u8,
+    idac: u16,
+}
+
+impl Clock {
+    fn for_rate(rate: u32) -> Option<Self> {
+        let (j, dsp_div, osr_div, fs_speed, idac) = match rate {
+            // Table 131: PLL = 98.304 MHz; DAC = 6.144 MHz.
+            32_000 => (48, 3, 12, 0, 1024),
+            // PLL = 90.3168 / 98.304 MHz; DSP = 1024 fs.
+            44_100 | 48_000 => (32, 2, 8, 0, 1024),
+            // Same clock trees as 44.1/48 kHz, double-speed filtering.
+            88_200 | 96_000 => (16, 2, 4, 1, 512),
+            _ => return None,
+        };
+        Some(Self {
+            j,
+            dsp_div,
+            osr_div,
+            fs_speed,
+            idac,
+        })
+    }
+}
+
+/// An exclusive control handle. Share the physical bus using an
+/// embedded-hal bus adapter; do not let another driver change its pages.
+pub struct Pcm5122<I> {
+    bus: I,
+    initialized: bool,
+    rate: Option<u32>,
+}
+
+impl<I: I2c> Pcm5122<I> {
+    /// Create a handle; construction performs no bus access.
+    pub fn new(bus: I) -> Self {
+        Self {
+            bus,
+            initialized: false,
+            rate: None,
+        }
+    }
+
+    /// Configure and unmute the DAC at unity digital gain (0 dB).
+    ///
+    /// I2S clocks must already be running. Call after every rate change,
+    /// before queuing new audio. Repeated calls at the same rate are no-ops.
+    /// On a failure, mute/standby is attempted, the cached configuration is
+    /// invalidated, and the next call retries initialization. A bus failure
+    /// can prevent the mute request itself from reaching the hardware.
+    pub fn configure(
+        &mut self,
+        rate: u32,
+        bits: u8,
+        delay: &mut impl DelayNs,
+    ) -> Result<(), Error<I::Error>> {
+        let clock = Clock::for_rate(rate).filter(|_| bits == 16);
+        let result = match clock {
+            Some(clock) if self.rate != Some(rate) => self.apply(clock, delay),
+            Some(_) => return Ok(()),
+            None => Err(Error::UnsupportedFormat { rate, bits }),
+        };
+        match result {
+            Ok(()) => {
+                self.rate = Some(rate);
+                Ok(())
+            }
+            Err(error) => {
+                self.rate = None;
+                self.initialized = false;
+                // Page selection may have failed while on the flex page.
+                let _ = self.write(PAGE, 0);
+                let _ = self.write(MUTE, BOTH_MUTED);
+                let _ = self.write(POWER, STANDBY);
+                Err(error)
+            }
+        }
+    }
+
+    fn apply(
+        &mut self,
+        clock: Clock,
+        delay: &mut impl DelayNs,
+    ) -> Result<(), Error<I::Error>> {
+        self.write(PAGE, 0)?;
+        self.write(MUTE, BOTH_MUTED)?;
+        delay.delay_ms(5); // Allow the soft-mute ramp with the old clocks.
+        self.write(POWER, STANDBY)?;
+        delay.delay_ms(5);
+        if !self.initialized {
+            // TI requires standby before resetting the modules/registers.
+            self.write(RESET, 0x11)?;
+            delay.delay_ms(5);
+            self.write(PAGE, 0)?;
+            self.write(MUTE, BOTH_MUTED)?;
+            self.write(POWER, STANDBY)?;
+            delay.delay_ms(5);
+            // VREF mode, constant output amplitude. Autoset is not used.
+            self.write(PAGE, 1)?;
+            self.write(1, 0)?;
+            self.write(PAGE, 253)?;
+            self.write(63, 0x11)?; // Enable advanced clock tree controls.
+            self.write(64, 0xff)?;
+            self.write(PAGE, 0)?;
+            self.write(9, 0)?; // BCK and LRCK inputs; never drive the HAT bus.
+            self.write(40, 0)?; // Philips I2S, 16-bit words.
+            self.write(41, 0)?; // No extra data offset.
+            self.write(42, 0x11)?; // Left/right stereo routing.
+            self.write(61, 0x30)?; // 0 dB, NOT 0x00 (+24 dB).
+            self.write(62, 0x30)?;
+        }
+        self.write(SYNC, 1)?;
+        self.write(PLL, 0)?;
+        // Disable autoset, ignore absent SCK and its frequency ratio.
+        // Keep BCK/LRCK/FS and PLL-lock fault protection enabled.
+        self.write(ERROR_DETECT, 0x1a)?;
+        self.write(13, 0x10)?; // PLL reference = BCK.
+        self.write(14, 0x10)?; // DAC source = PLL.
+        self.write(20, 0)?; // P = 1.
+        self.write(21, clock.j)?;
+        self.write(22, 0)?; // D = 0 (integer PLL).
+        self.write(23, 0)?;
+        self.write(24, 1)?; // R = 2.
+        self.write(27, clock.dsp_div - 1)?;
+        self.write(28, 15)?; // DAC clock = PLL / 16.
+        self.write(29, 3)?; // Charge pump = DAC clock / 4.
+        self.write(30, clock.osr_div - 1)?; // OSR clock = 16 fs.
+        self.write(34, clock.fs_speed)?;
+        self.write(35, (clock.idac >> 8) as u8)?;
+        self.write(36, clock.idac as u8)?;
+        self.write(PLL, 1)?;
+        // Release standby while still soft-muted so the PLL and clock
+        // state machine can run. Never unmute before confirming lock.
+        self.write(SYNC, 0)?;
+        self.write(POWER, 0)?;
+        // PLCK (bit 4) is active-high UNLOCKED, per TI Table 57.
+        for _ in 0..LOCK_POLLS {
+            delay.delay_ms(1);
+            if self.read(PLL)? & 0x10 == 0 {
+                delay.delay_ms(10);
+                self.write(MUTE, 0)?;
+                self.initialized = true;
+                return Ok(());
+            }
+        }
+        Err(Error::PllUnlocked)
+    }
+
+    fn write(
+        &mut self,
+        register: u8,
+        value: u8,
+    ) -> Result<(), Error<I::Error>> {
+        self.bus
+            .write(ADDRESS, &[register, value])
+            .map_err(Error::Bus)
+    }
+
+    fn read(&mut self, register: u8) -> Result<u8, Error<I::Error>> {
+        let mut value = [0];
+        self.bus
+            .write_read(ADDRESS, &[register], &mut value)
+            .map_err(Error::Bus)?;
+        Ok(value[0])
+    }
+}
+
