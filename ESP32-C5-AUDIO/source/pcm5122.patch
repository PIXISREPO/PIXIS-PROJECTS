@@ -0,0 +1,222 @@
+extern crate std;
+
+use super::*;
+use embedded_hal::i2c::{ErrorKind, ErrorType, Operation};
+use std::vec::Vec;
+
+#[derive(Default)]
+struct Bus {
+    writes: Vec<(u8, u8, u8)>,
+    page: u8,
+    unlocked: usize,
+    lock_reads: usize,
+    fail_at: Option<usize>,
+    operations: usize,
+}
+impl ErrorType for Bus {
+    type Error = ErrorKind;
+}
+impl I2c for Bus {
+    fn transaction(
+        &mut self,
+        address: u8,
+        operations: &mut [Operation<'_>],
+    ) -> Result<(), Self::Error> {
+        assert_eq!(address, ADDRESS);
+        let index = self.operations;
+        self.operations += 1;
+        if self.fail_at == Some(index) {
+            return Err(ErrorKind::Bus);
+        }
+        match operations {
+            [Operation::Write(bytes)] => {
+                assert_eq!(bytes.len(), 2);
+                let (reg, value) = (bytes[0], bytes[1]);
+                self.writes.push((self.page, reg, value));
+                if reg == PAGE {
+                    self.page = value;
+                }
+            }
+            [Operation::Write(bytes), Operation::Read(value)] => {
+                assert_eq!(*bytes, &[PLL]);
+                assert_eq!(self.page, 0);
+                value[0] = if self.lock_reads < self.unlocked {
+                    0x11
+                } else {
+                    0x01
+                };
+                self.lock_reads += 1;
+            }
+            _ => panic!("unexpected I2C transaction"),
+        }
+        Ok(())
+    }
+}
+#[derive(Default)]
+struct Delay(u64);
+impl DelayNs for Delay {
+    fn delay_ns(&mut self, ns: u32) {
+        self.0 += u64::from(ns);
+    }
+}
+fn last(bus: &Bus, register: u8) -> Option<u8> {
+    bus.writes
+        .iter()
+        .rev()
+        .find(|(page, reg, _)| *page == 0 && *reg == register)
+        .map(|(_, _, v)| *v)
+}
+
+#[test]
+fn clock_plans_obey_ti_limits_and_exact_ratios() {
+    for rate in [32_000, 44_100, 48_000, 88_200, 96_000] {
+        let c = Clock::for_rate(rate).unwrap();
+        let bck = rate * 32;
+        let pll = bck * u32::from(c.j) * 2;
+        let dsp = pll / u32::from(c.dsp_div);
+        let dac = pll / 16;
+        assert!((1_000_000..=20_000_000).contains(&bck));
+        assert!((64_000_000..=100_000_000).contains(&pll));
+        assert!(dsp <= 50_000_000);
+        assert_eq!(dsp, rate * u32::from(c.idac));
+        assert_eq!(dac / u32::from(c.osr_div), rate * 16);
+        assert!(dac <= 6_144_000);
+        assert!(dac / 4 <= 1_536_000);
+    }
+}
+
+#[test]
+fn init_uses_correct_pages_slave_i2s_and_unity_gain() {
+    let mut d = Pcm5122::new(Bus::default());
+    d.configure(44_100, 16, &mut Delay::default()).unwrap();
+    assert!(d.bus.writes.contains(&(253, 63, 0x11)));
+    assert!(d.bus.writes.contains(&(253, 64, 0xff)));
+    for (reg, value) in [
+        (9, 0),
+        (13, 0x10),
+        (14, 0x10),
+        (37, 0x1a),
+        (40, 0),
+        (61, 0x30),
+        (62, 0x30),
+        (POWER, 0),
+        (MUTE, 0),
+    ] {
+        assert_eq!(last(&d.bus, reg), Some(value));
+    }
+    let standby = d
+        .bus
+        .writes
+        .iter()
+        .position(|w| *w == (0, POWER, STANDBY))
+        .unwrap();
+    let reset = d
+        .bus
+        .writes
+        .iter()
+        .position(|w| *w == (0, RESET, 0x11))
+        .unwrap();
+    assert!(standby < reset);
+    assert_eq!(d.bus.writes.last(), Some(&(0, MUTE, 0)));
+}
+
+#[test]
+fn programs_each_rate_and_avoids_redundant_same_rate_writes() {
+    let mut d = Pcm5122::new(Bus::default());
+    let mut delay = Delay::default();
+    for rate in [32_000, 44_100, 48_000, 88_200, 96_000, 44_100] {
+        d.configure(rate, 16, &mut delay).unwrap();
+        let c = Clock::for_rate(rate).unwrap();
+        assert_eq!(last(&d.bus, 21), Some(c.j));
+        assert_eq!(last(&d.bus, 27), Some(c.dsp_div - 1));
+        assert_eq!(last(&d.bus, 30), Some(c.osr_div - 1));
+        assert_eq!(last(&d.bus, 34), Some(c.fs_speed));
+        let count = d.bus.operations;
+        d.configure(rate, 16, &mut delay).unwrap();
+        assert_eq!(count, d.bus.operations);
+    }
+    assert_eq!(
+        d.bus
+            .writes
+            .iter()
+            .filter(|w| **w == (0, RESET, 0x11))
+            .count(),
+        1
+    );
+}
+
+#[test]
+fn polls_active_high_unlock_flag_before_unmuting() {
+    let bus = Bus {
+        unlocked: 3,
+        ..Bus::default()
+    };
+    let mut d = Pcm5122::new(bus);
+    d.configure(48_000, 16, &mut Delay::default()).unwrap();
+    assert_eq!(d.bus.lock_reads, 4);
+}
+
+#[test]
+fn missing_clocks_timeout_leaves_output_muted_and_retry_works() {
+    let bus = Bus {
+        unlocked: usize::MAX,
+        ..Bus::default()
+    };
+    let mut d = Pcm5122::new(bus);
+    assert_eq!(
+        d.configure(48_000, 16, &mut Delay::default()),
+        Err(Error::PllUnlocked)
+    );
+    assert_eq!(d.bus.lock_reads, LOCK_POLLS);
+    assert_eq!(last(&d.bus, MUTE), Some(BOTH_MUTED));
+    assert_eq!(last(&d.bus, POWER), Some(STANDBY));
+    d.bus.unlocked = 0;
+    d.configure(48_000, 16, &mut Delay::default()).unwrap();
+}
+
+#[test]
+fn unsupported_formats_mute_previous_output_and_can_recover() {
+    let mut d = Pcm5122::new(Bus::default());
+    let mut delay = Delay::default();
+    d.configure(44_100, 16, &mut delay).unwrap();
+    for (rate, bits) in [
+        (8_000, 16),
+        (16_000, 16),
+        (22_050, 16),
+        (24_000, 16),
+        (192_000, 16),
+        (44_100, 24),
+        (44_100, 32),
+    ] {
+        assert_eq!(
+            d.configure(rate, bits, &mut delay),
+            Err(Error::UnsupportedFormat { rate, bits })
+        );
+        assert_eq!(last(&d.bus, MUTE), Some(BOTH_MUTED));
+        assert_eq!(last(&d.bus, POWER), Some(STANDBY));
+    }
+    d.configure(44_100, 16, &mut delay).unwrap();
+    assert_eq!(last(&d.bus, MUTE), Some(0));
+}
+
+#[test]
+fn every_bus_failure_is_reported_and_the_next_call_retries() {
+    let mut good = Pcm5122::new(Bus::default());
+    good.configure(44_100, 16, &mut Delay::default()).unwrap();
+    for fail_at in 0..good.bus.operations {
+        let bus = Bus {
+            fail_at: Some(fail_at),
+            ..Bus::default()
+        };
+        let mut d = Pcm5122::new(bus);
+        assert_eq!(
+            d.configure(44_100, 16, &mut Delay::default()),
+            Err(Error::Bus(ErrorKind::Bus))
+        );
+        assert_eq!(d.rate, None);
+        assert!(!d.initialized);
+        d.bus.fail_at = None;
+        d.configure(44_100, 16, &mut Delay::default()).unwrap();
+        assert_eq!(d.rate, Some(44_100));
+    }
+}
